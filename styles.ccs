:root {
  --navy: #123b63;
  --navy-dark: #0b2947;
  --red: #c92f3f;
  --red-dark: #ad2332;
  --ink: #172b3f;
  --muted: #68798a;
  --line: #dce4eb;
  --bg: #f3f6f8;
  --surface: #fff;
  --green: #197052;
  --shadow: 0 8px 24px rgba(13, 40, 65, .08);
}

* { box-sizing: border-box; }
html { color-scheme: light; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding-bottom: 92px; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid rgba(35, 112, 171, .25); outline-offset: 2px; }

.topbar { height: 72px; background: var(--navy-dark); display: flex; align-items: center; justify-content: space-between; padding: 0 max(22px, calc((100vw - 780px) / 2)); color: #fff; position: sticky; top: 0; z-index: 10; box-shadow: 0 2px 12px rgba(2, 19, 34, .18); }
.brand { display: flex; align-items: center; color: #fff; text-decoration: none; gap: 14px; }
.brand img { width: 142px; max-height: 42px; object-fit: contain; filter: brightness(0) invert(1); }
.brand-divider { height: 26px; width: 1px; background: rgba(255,255,255,.35); }
.brand strong { letter-spacing: 2.2px; font-size: 13px; }
.topbar-actions { display: flex; align-items: center; gap: 12px; }
.icon-button { height: 36px; width: 36px; border: 1px solid rgba(255,255,255,.4); border-radius: 50%; color: #fff; background: transparent; font-weight: 800; }
.user-avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #e9eef3; color: var(--navy-dark); font-size: 11px; font-weight: 800; }

main { max-width: 780px; margin: auto; }
.hero { min-height: 180px; background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%); color: #fff; padding: 34px 28px 55px; display: flex; justify-content: space-between; align-items: center; }
.eyebrow, .section-kicker { font-size: 10px; letter-spacing: 1.8px; font-weight: 800; margin: 0 0 8px; color: #7790a7; }
.hero .eyebrow { color: #afc6da; }
.hero h1 { font-size: clamp(26px, 5vw, 32px); letter-spacing: -.5px; margin: 0 0 8px; }
.hero p:last-child { margin: 0; color: #d0dce7; font-size: 14px; }
.hero-date { border-left: 1px solid rgba(255,255,255,.25); padding-left: 24px; display: flex; flex-direction: column; gap: 5px; text-align: right; }
.hero-date span { color: #afc6da; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
.hero-date strong { font-size: 14px; font-weight: 600; }

.project-bar { margin: -27px 20px 0; background: var(--surface); border: 1px solid rgba(217,226,234,.85); border-radius: 12px; min-height: 88px; padding: 15px 18px; box-shadow: var(--shadow); display: flex; align-items: center; justify-content: space-between; position: relative; }
.project-bar > div { display: flex; align-items: center; gap: 14px; }
.project-mark { display: grid !important; place-items: center; width: 42px; height: 42px; flex: 0 0 auto; border-radius: 9px; background: #eef3f7; color: var(--navy); font-weight: 800; }
.project-bar small, .project-bar strong, .project-bar div div span { display: block; }
.project-bar small { font-size: 9px; color: #8492a0; letter-spacing: 1.2px; font-weight: 800; }
.project-bar strong { font-size: 15px; margin: 4px 0; }
.project-bar div div span { font-size: 12px; color: var(--muted); }
.project-bar button, .section-heading button { background: #f8fafb; border: 1px solid var(--line); border-radius: 7px; color: var(--navy); font-size: 11px; font-weight: 800; padding: 8px 11px; }

.quick-actions { padding: 26px 20px 16px; }
.section-label { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 11px; }
.section-label span { font-size: 14px; font-weight: 800; }
.section-label small { color: var(--muted); font-size: 11px; }
.primary-action { width: 100%; min-height: 80px; border: 0; border-radius: 10px; background: linear-gradient(135deg, var(--red), var(--red-dark)); color: #fff; display: flex; align-items: center; text-align: left; padding: 0 20px; box-shadow: 0 7px 18px rgba(185, 36, 52, .22); }
.primary-action > span { font-size: 34px; font-weight: 200; margin-right: 16px; }
.primary-action div { display: flex; flex-direction: column; gap: 4px; flex: 1; }
.primary-action strong { font-size: 16px; }
.primary-action small { color: #ffe1e4; }
.primary-action b { font-size: 28px; font-weight: 300; }
.secondary-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
.secondary-actions button { height: 62px; background: var(--surface); border: 1px solid var(--line); border-radius: 9px; color: var(--navy); font-size: 12px; font-weight: 700; box-shadow: 0 2px 5px rgba(13,40,65,.03); }
.secondary-actions span { color: var(--red); font-size: 19px; margin-right: 9px; }

.items-section { padding: 7px 20px 20px; }
.section-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.section-heading > div { display: flex; align-items: center; gap: 9px; }
.section-heading h2 { font-size: 20px; margin: 0; letter-spacing: -.2px; }
.section-kicker { margin-bottom: 4px; }
.count { color: #fff; background: var(--navy); font-weight: 800; border-radius: 20px; min-width: 23px; text-align: center; padding: 4px 7px; font-size: 10px; }
.filters { display: flex; gap: 7px; overflow: auto; padding-bottom: 11px; }
.filters button { border: 1px solid var(--line); background: #fff; color: var(--muted); border-radius: 20px; padding: 7px 14px; font-size: 11px; }
.filters button.active { background: var(--navy); border-color: var(--navy); color: #fff; }
.item-list { display: grid; gap: 10px; }
.item-card { background: #fff; border: 1px solid var(--line); border-radius: 10px; display: grid; grid-template-columns: 96px 1fr; min-height: 116px; overflow: hidden; box-shadow: 0 3px 9px rgba(18,39,58,.04); transition: transform .15s, box-shadow .15s; }
.item-card:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
.item-photo { background: #e4e9ed; position: relative; min-height: 116px; }
.item-photo img { height: 100%; width: 100%; object-fit: cover; }
.item-photo .placeholder { height: 100%; display: grid; place-items: center; color: #778896; font-size: 24px; }
.photo-count { position: absolute; bottom: 7px; left: 7px; background: rgba(7,29,45,.88); color: #fff; border-radius: 4px; padding: 3px 6px; font-size: 9px; }
.item-content { padding: 13px 14px; min-width: 0; }
.badges { display: flex; gap: 5px; }
.badge { font-size: 8px; font-weight: 900; letter-spacing: .7px; border-radius: 3px; padding: 3px 6px; text-transform: uppercase; }
.urgent { background: #fce5e6; color: #aa2933; }.new { background: #e7f0f8; color: #285f88; }.assigned { background: #e2f2eb; color: #17684d; }
.item-content h3 { font-size: 14px; margin: 8px 0 5px; }
.item-content p { font-size: 11px; color: var(--muted); margin: 0 0 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 10px; color: #71808c; }
.avatar { display: inline-grid; place-items: center; width: 21px; height: 21px; background: #e5ebf0; border-radius: 50%; font-size: 8px; color: var(--navy); font-style: normal; font-weight: 900; margin-right: 6px; }
.view-all { width: 100%; height: 52px; background: transparent; border: 0; color: var(--navy); font-size: 11px; font-weight: 800; }
.view-all span { font-size: 19px; margin-left: 5px; }
.empty { text-align: center; background: #fff; padding: 30px; border: 1px solid var(--line); border-radius: 10px; }
.empty span { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: #daf3e8; color: var(--green); font-size: 22px; }
.empty h3 { margin-bottom: 5px; }.empty p { color: var(--muted); font-size: 13px; }

.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; height: 76px; background: #fff; border-top: 1px solid var(--line); display: flex; justify-content: center; z-index: 20; padding-bottom: env(safe-area-inset-bottom); }
.bottom-nav button { width: min(18%, 135px); border: 0; background: transparent; color: #778794; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; font-size: 10px; font-weight: 700; }
.bottom-nav button span { font-size: 18px; }.bottom-nav .active { color: var(--red); }
.bottom-nav .nav-add { transform: translateY(-18px); color: var(--navy); }.bottom-nav .nav-add span { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--red); color: #fff; font-size: 30px; border: 5px solid var(--bg); box-sizing: content-box; }.bottom-nav .nav-add b { font-size: 10px; }

dialog { border: 0; border-radius: 14px; padding: 0; width: min(600px, calc(100% - 24px)); max-height: 92vh; color: var(--ink); box-shadow: 0 24px 70px rgba(0,24,46,.35); }
dialog::backdrop { background: rgba(3,26,45,.72); } dialog form { padding: 24px; }
.dialog-head { display: flex; justify-content: space-between; align-items: start; }.dialog-head h2 { margin: 0 0 18px; font-size: 24px; }.close { border: 0; background: #edf1f4; color: #53616e; border-radius: 50%; height: 36px; width: 36px; font-size: 22px; }
.photo-drop { border: 2px dashed #aebbc6 !important; background: #f7f9fa; border-radius: 10px; min-height: 135px; display: flex !important; align-items: center; justify-content: center; flex-direction: column; color: var(--navy); margin-bottom: 14px; }.photo-drop input { display: none; }.photo-drop .camera { font-size: 27px; color: var(--red); margin-bottom: 5px; }.photo-drop small { color: var(--muted); margin-top: 4px; font-weight: 400; }
.photo-preview { display: flex; gap: 8px; overflow: auto; margin-bottom: 12px; }.photo-preview img { width: 90px; height: 70px; object-fit: cover; border-radius: 6px; }
form label { display: block; font-size: 12px; font-weight: 800; color: #3a4b5c; margin-top: 12px; } input, textarea, select { display: block; width: 100%; margin-top: 6px; border: 1px solid #bfc9d1; border-radius: 7px; padding: 12px; font-size: 16px; color: var(--ink); background: #fff; } textarea { resize: vertical; }.form-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 12px; }.save-button { border: 0; background: var(--red); color: #fff; width: 100%; padding: 15px; border-radius: 8px; font-weight: 800; margin-top: 20px; }.small-dialog { padding: 28px; }.small-dialog .close { float: right; }.small-dialog p { line-height: 1.6; color: var(--muted); }
.toast { position: fixed; left: 50%; bottom: 95px; transform: translate(-50%,20px); background: #102b43; color: #fff; border-radius: 7px; padding: 11px 18px; font-size: 13px; opacity: 0; pointer-events: none; transition: .2s; z-index: 40; }.toast.show { opacity: 1; transform: translate(-50%,0); }

@media (min-width: 781px) { body { padding-bottom: 30px; }.topbar { padding-left: calc((100vw - 780px)/2 + 24px); padding-right: calc((100vw - 780px)/2 + 24px); } main { box-shadow: 0 0 35px rgba(11,49,88,.08); background: #f8fafb; min-height: 100vh; }.bottom-nav { position: sticky; width: 780px; margin: auto; border: 1px solid var(--line); border-radius: 12px 12px 0 0; }.items-section { padding-bottom: 25px; } }
@media (max-width: 520px) { .hero-date { display: none; }.hero { min-height: 165px; }.form-grid { grid-template-columns: 1fr; }.brand img { width: 125px; }.item-card { grid-template-columns: 88px 1fr; }.project-bar { margin-left: 14px; margin-right: 14px; }.quick-actions, .items-section { padding-left: 14px; padding-right: 14px; } }
