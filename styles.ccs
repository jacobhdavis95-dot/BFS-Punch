/* =========================================================
   BFS RALEIGH INSTALL SERVICES
   FIELD PUNCH — UPDATED PROFESSIONAL UI
   ========================================================= */

:root {
    --bfs-red: #c8102e;
    --bfs-red-dark: #9f0c24;
    --bfs-red-soft: #fff1f3;

    --black: #151515;
    --charcoal: #222426;
    --slate: #34383d;

    --text: #202124;
    --text-soft: #666b72;
    --text-light: #8c9198;

    --border: #e2e4e7;
    --border-dark: #d2d5d9;

    --surface: #ffffff;
    --background: #f4f5f6;
    --background-dark: #eceef0;

    --green: #18864b;
    --green-soft: #e9f7ef;

    --orange: #c97800;
    --orange-soft: #fff4df;

    --blue: #2167a8;
    --blue-soft: #eaf3fb;

    --danger: #c8102e;

    --radius-sm: 8px;
    --radius: 12px;
    --radius-lg: 16px;

    --shadow-sm:
        0 1px 2px rgba(0,0,0,.04),
        0 2px 6px rgba(0,0,0,.03);

    --shadow:
        0 4px 18px rgba(25,30,35,.07);

    --shadow-lg:
        0 16px 45px rgba(0,0,0,.18);
}


/* =========================================================
   GLOBAL
   ========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
}

body {
    margin: 0;
    min-height: 100vh;

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    background: var(--background);
    color: var(--text);

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

button:disabled {
    opacity: .5;
    cursor: not-allowed;
}

.app {
    min-height: 100vh;
}


/* =========================================================
   TOP NAVIGATION
   ========================================================= */

.topbar {
    position: sticky;
    top: 0;
    z-index: 500;

    background: rgba(20,20,20,.98);
    color: white;

    border-bottom: 3px solid var(--bfs-red);

    box-shadow:
        0 3px 15px rgba(0,0,0,.18);
}

.topbar-inner {
    width: 100%;
    max-width: 1180px;

    margin: 0 auto;
    padding: 11px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;
}


/* =========================================================
   BRAND
   ========================================================= */

.brand {
    display: flex;
    align-items: center;
    gap: 12px;

    min-width: 0;
}

.brand-mark {
    width: 47px;
    height: 47px;

    flex: 0 0 47px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--bfs-red);
    color: white;

    border-radius: 7px;

    font-size: 15px;
    font-weight: 900;
    letter-spacing: -.5px;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.12);
}

.brand-title {
    font-size: 15px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -.15px;

    white-space: nowrap;
}

.brand-subtitle {
    margin-top: 3px;

    color: #aeb1b5;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
    text-transform: uppercase;
}


/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.header-actions {
    display: flex;
    align-items: center;
    gap: 7px;
}

.icon-button {
    min-height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    padding: 9px 12px;

    border: 1px solid #404246;
    border-radius: 8px;

    background: #292b2e;
    color: white;

    font-size: 12px;
    font-weight: 700;

    transition:
        background .15s ease,
        border-color .15s ease,
        transform .1s ease;
}

.icon-button:hover {
    background: #35383b;
    border-color: #505358;
}

.icon-button:active {
    transform: translateY(1px);
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
    position: relative;
    overflow: hidden;

    background:
        linear-gradient(
            115deg,
            #c8102e 0%,
            #b10d27 48%,
            #8e091d 100%
        );

    color: white;
}

.hero::after {
    content: "";

    position: absolute;
    right: -70px;
    top: -130px;

    width: 400px;
    height: 400px;

    border: 70px solid rgba(255,255,255,.035);

    border-radius: 50%;
}

.hero-inner {
    position: relative;
    z-index: 1;

    max-width: 1180px;
    margin: 0 auto;

    padding: 32px 20px 36px;
}

.hero-eyebrow {
    margin-bottom: 6px;

    font-size: 10px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 2px;

    opacity: .76;
}

.hero h1 {
    margin: 0;

    font-size: clamp(30px, 5vw, 46px);
    line-height: 1;

    font-weight: 850;
    letter-spacing: -1.5px;
}

.hero p {
    margin: 9px 0 0;

    font-size: 13px;
    font-weight: 500;

    opacity: .88;

    letter-spacing: .1px;
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.container {
    width: 100%;
    max-width: 1180px;

    margin: 0 auto;

    padding: 22px 18px 110px;
}


/* =========================================================
   CARDS
   ========================================================= */

.card {
    margin-bottom: 17px;

    overflow: hidden;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    box-shadow: var(--shadow-sm);
}

.card-header {
    min-height: 55px;

    padding: 14px 18px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    border-bottom: 1px solid var(--border);

    background:
        linear-gradient(
            180deg,
            #ffffff,
            #fcfcfc
        );
}

.card-header h2 {
    margin: 0;

    font-size: 15px;
    font-weight: 800;

    letter-spacing: -.2px;
}

.card-header > span {
    color: var(--text-light);

    font-size: 10px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: .7px;
}

.card-body {
    padding: 19px;
}


/* =========================================================
   FORM LAYOUT
   ========================================================= */

.form-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0,1fr));

    gap: 15px;
}

.form-group {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 6px;
}

.form-group.full {
    grid-column: 1 / -1;
}

label {
    color: #555a60;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .65px;
    text-transform: uppercase;
}

input,
select,
textarea {
    width: 100%;

    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);

    background: #fff;
    color: var(--text);

    padding: 12px 13px;

    font-size: 14px;

    outline: none;

    transition:
        border-color .15s ease,
        box-shadow .15s ease,
        background .15s ease;
}

input {
    min-height: 45px;
}

select {
    min-height: 45px;

    cursor: pointer;
}

textarea {
    min-height: 105px;

    line-height: 1.45;

    resize: vertical;
}

input::placeholder,
textarea::placeholder {
    color: #a0a4aa;
}

input:hover,
select:hover,
textarea:hover {
    border-color: #bec2c7;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--bfs-red);

    box-shadow:
        0 0 0 3px rgba(200,16,46,.09);
}


/* =========================================================
   PUNCH SUMMARY
   ========================================================= */

.summary-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0,1fr));

    gap: 10px;
}

.summary-box {
    position: relative;

    overflow: hidden;

    padding: 15px 12px;

    text-align: center;

    background: #f7f8f9;

    border: 1px solid #eceef0;

    border-radius: 10px;
}

.summary-box::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 3px;

    background: #555;
}

.summary-box.open::before {
    background: var(--bfs-red);
}

.summary-box.progress::before {
    background: var(--orange);
}

.summary-box.complete::before {
    background: var(--green);
}

.summary-number {
    font-size: 27px;
    line-height: 1;

    font-weight: 900;

    letter-spacing: -1px;
}

.summary-label {
    margin-top: 6px;

    color: var(--text-light);

    font-size: 9px;
    font-weight: 800;

    letter-spacing: .7px;
    text-transform: uppercase;
}

.summary-box.open .summary-number {
    color: var(--bfs-red);
}

.summary-box.progress .summary-number {
    color: var(--orange);
}

.summary-box.complete .summary-number {
    color: var(--green);
}


/* =========================================================
   PROGRESS BAR
   ========================================================= */

.progress-bar {
    width: 100%;
    height: 7px;

    margin-top: 16px;

    overflow: hidden;

    background: #e6e8ea;

    border-radius: 999px;
}

.progress-fill {
    width: 0%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            #18864b,
            #25a75e
        );

    border-radius: inherit;

    transition: width .3s ease;
}


/* =========================================================
   MAIN ACTION BUTTONS
   ========================================================= */

.action-grid {
    display: grid;

    grid-template-columns:
        minmax(0,2fr)
        minmax(180px,1fr);

    gap: 10px;

    margin-bottom: 17px;
}

.btn {
    min-height: 46px;

    border: 0;
    border-radius: 9px;

    padding: 12px 17px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    font-size: 13px;
    font-weight: 800;

    transition:
        transform .1s ease,
        box-shadow .15s ease,
        background .15s ease;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn:active {
    transform: translateY(0);
}

.btn-primary {
    background:
        linear-gradient(
            180deg,
            var(--bfs-red),
            #b70d29
        );

    color: white;

    box-shadow:
        0 3px 8px rgba(200,16,46,.18);
}

.btn-primary:hover {
    background: var(--bfs-red-dark);
}

.btn-dark {
    background: var(--charcoal);
    color: white;
}

.btn-dark:hover {
    background: #111;
}

.btn-light {
    background: white;

    border: 1px solid var(--border-dark);

    color: var(--text);
}

.btn-light:hover {
    background: #f7f7f7;
}

.btn-success {
    background: var(--green);
    color: white;
}

.btn-danger {
    background: var(--bfs-red-soft);
    color: var(--bfs-red);
}

.btn-block {
    width: 100%;
}


/* =========================================================
   FILTERS
   ========================================================= */

.filters {
    display: flex;
    align-items: center;

    gap: 6px;

    overflow-x: auto;

    padding: 2px;

    scrollbar-width: none;
}

.filters::-webkit-scrollbar {
    display: none;
}

.filter-btn {
    flex: 0 0 auto;

    padding: 7px 11px;

    border: 1px solid var(--border);
    border-radius: 999px;

    background: white;
    color: #666b71;

    font-size: 10px;
    font-weight: 800;

    transition: .15s ease;
}

.filter-btn:hover {
    border-color: #b9bdc2;
    background: #f8f8f8;
}

.filter-btn.active {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: white;
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-state {
    padding: 55px 20px;

    text-align: center;

    color: var(--text-light);

    font-size: 13px;
}

.empty-icon {
    width: 56px;
    height: 56px;

    margin: 0 auto 13px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #f2f3f4;

    border-radius: 50%;

    font-size: 26px;
}

.empty-state strong {
    display: block;

    margin-bottom: 5px;

    color: #363a3e;

    font-size: 14px;
}


/* =========================================================
   PUNCH LIST
   ========================================================= */

.punch-list {
    display: flex;
    flex-direction: column;

    gap: 12px;
}

.punch-item {
    position: relative;

    overflow: hidden;

    background: white;

    border: 1px solid var(--border);

    border-radius: 11px;

    box-shadow: var(--shadow-sm);

    transition:
        border-color .15s ease,
        box-shadow .15s ease,
        transform .15s ease;
}

.punch-item:hover {
    border-color: #d2d5d8;

    box-shadow: var(--shadow);
}


/* =========================================================
   PUNCH ITEM HEADER
   ========================================================= */

.punch-item-top {
    min-height: 45px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 10px 13px;

    background: #fafafa;

    border-bottom: 1px solid var(--border);
}

.item-number {
    color: #4b4f54;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: .8px;
}

.badges {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 5px;
}

.badge {
    display: inline-flex;
    align-items: center;

    min-height: 22px;

    padding: 4px 8px;

    border-radius: 999px;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: .55px;
    text-transform: uppercase;
}


/* STATUS */

.badge-open {
    background: var(--bfs-red-soft);
    color: var(--bfs-red);
}

.badge-progress {
    background: var(--orange-soft);
    color: #9b5a00;
}

.badge-complete {
    background: var(--green-soft);
    color: var(--green);
}


/* PRIORITY */

.badge-critical {
    background: var(--bfs-red);
    color: white;
}

.badge-important {
    background: #fff0d6;
    color: #a45e00;
}

.badge-normal {
    background: #eceeef;
    color: #62676c;
}


/* =========================================================
   PUNCH CONTENT
   ========================================================= */

.punch-content {
    padding: 15px;
}

.punch-location {
    margin-bottom: 6px;

    color: var(--bfs-red);

    font-size: 9px;
    font-weight: 900;

    letter-spacing: .7px;
    text-transform: uppercase;
}

.punch-description {
    max-width: 850px;

    color: #25282b;

    font-size: 14px;
    font-weight: 650;

    line-height: 1.45;
}

.punch-meta {
    margin-top: 12px;

    display: flex;
    flex-wrap: wrap;

    gap: 7px 18px;

    color: #71767c;

    font-size: 10px;
}

.punch-meta strong {
    color: #4d5156;
}


/* =========================================================
   PHOTOS
   ========================================================= */

.photo-grid {
    margin-top: 14px;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0,1fr));

    gap: 7px;
}

.photo-grid img {
    display: block;

    width: 100%;
    height: 145px;

    object-fit: cover;

    background: #eee;

    border: 1px solid #ddd;

    border-radius: 8px;
}


/* =========================================================
   ITEM ACTIONS
   ========================================================= */

.item-actions {
    display: grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap: 7px;

    padding: 9px;

    border-top: 1px solid var(--border);

    background: #fcfcfc;
}

.item-actions button {
    min-height: 37px;

    border: 0;
    border-radius: 7px;

    padding: 8px;

    font-size: 10px;
    font-weight: 800;

    transition:
        background .15s ease,
        transform .1s ease;
}

.item-actions button:active {
    transform: scale(.98);
}

.action-edit {
    background: #eceeef;
    color: #44494e;
}

.action-edit:hover {
    background: #e0e2e4;
}

.action-complete {
    background: var(--green-soft);
    color: var(--green);
}

.action-complete:hover {
    background: #ddf2e5;
}

.action-delete {
    background: var(--bfs-red-soft);
    color: var(--bfs-red);
}

.action-delete:hover {
    background: #fbe3e7;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal {
    display: none;

    position: fixed;
    inset: 0;

    z-index: 2000;

    overflow-y: auto;

    padding: 22px 15px;

    background: rgba(12,14,16,.72);

    backdrop-filter: blur(3px);
}

.modal.active {
    display: block;
}

.modal-panel {
    width: 100%;
    max-width: 680px;

    margin: 20px auto;

    overflow: hidden;

    background: white;

    border: 1px solid rgba(255,255,255,.1);

    border-radius: 14px;

    box-shadow: var(--shadow-lg);
}

.modal-header {
    min-height: 59px;

    padding: 15px 19px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    background: var(--charcoal);
    color: white;

    border-bottom: 3px solid var(--bfs-red);
}

.modal-header h2 {
    margin: 0;

    font-size: 16px;
    font-weight: 800;
}

.close-modal {
    width: 34px;
    height: 34px;

    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 7px;

    background: rgba(255,255,255,.08);
    color: white;

    font-size: 22px;
    line-height: 1;
}

.close-modal:hover {
    background: rgba(255,255,255,.14);
}

.modal-body {
    padding: 20px;
}

.modal-footer {
    padding: 13px 20px 19px;

    display: grid;

    grid-template-columns:
        minmax(110px,1fr)
        minmax(180px,2fr);

    gap: 8px;

    border-top: 1px solid #eee;
}


/* =========================================================
   PHOTO UPLOAD
   ========================================================= */

.photo-upload {
    position: relative;

    min-height: 115px;

    padding: 22px 15px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    border: 2px dashed #c9ccd0;

    border-radius: 10px;

    background: #fafafa;

    transition:
        border-color .15s ease,
        background .15s ease;
}

.photo-upload:hover {
    border-color: var(--bfs-red);
    background: #fffafb;
}

.photo-upload input {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    opacity: 0;

    cursor: pointer;
}

.photo-upload strong {
    margin-bottom: 5px;

    color: #373b3f;

    font-size: 13px;
}

.photo-upload span {
    max-width: 300px;

    color: var(--text-light);

    font-size: 10px;

    line-height: 1.4;
}

.photo-preview {
    margin-top: 10px;

    display: grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap: 7px;
}

.preview-wrapper {
    position: relative;

    overflow: hidden;

    border-radius: 8px;
}

.preview-wrapper img {
    display: block;

    width: 100%;
    height: 120px;

    object-fit: cover;

    border: 1px solid #ddd;

    border-radius: 8px;
}

.remove-photo {
    position: absolute;

    top: 6px;
    right: 6px;

    width: 26px;
    height: 26px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50%;

    background: rgba(15,15,15,.8);
    color: white;

    font-size: 13px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
    padding: 4px 15px 25px;

    text-align: center;

    color: #979ba0;

    font-size: 9px;
    font-weight: 600;

    letter-spacing: .3px;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 800px) {

    .topbar-inner {
        padding-left: 15px;
        padding-right: 15px;
    }

    .hero-inner {
        padding-left: 16px;
        padding-right: 16px;
    }

    .container {
        padding-left: 13px;
        padding-right: 13px;
    }

    .photo-grid img {
        height: 125px;
    }

}


/* =========================================================
   MOBILE FIELD MODE
   ========================================================= */

@media (max-width: 650px) {

    body {
        background: #eff1f2;
    }


    /* HEADER */

    .topbar-inner {
        padding: 9px 11px;
    }

    .brand {
        gap: 9px;
    }

    .brand-mark {
        width: 40px;
        height: 40px;

        flex-basis: 40px;

        font-size: 13px;
    }

    .brand-title {
        max-width: 175px;

        overflow: hidden;

        font-size: 12px;

        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .brand-subtitle {
        margin-top: 2px;

        font-size: 8px;
    }

    .header-actions {
        gap: 5px;
    }

    .icon-button {
        width: 40px;
        min-height: 40px;

        padding: 0;

        font-size: 15px;
    }

    .header-actions .label {
        display: none;
    }


    /* HERO */

    .hero-inner {
        padding: 22px 14px 25px;
    }

    .hero-eyebrow {
        font-size: 8px;
    }

    .hero h1 {
        font-size: 31px;

        letter-spacing: -1px;
    }

    .hero p {
        margin-top: 7px;

        font-size: 11px;
    }


    /* CONTENT */

    .container {
        padding:
            13px
            10px
            100px;
    }

    .card {
        margin-bottom: 11px;

        border-radius: 10px;
    }

    .card-header {
        min-height: 50px;

        padding: 12px 13px;

        align-items: flex-start;
    }

    .card-header h2 {
        font-size: 13px;
    }

    .card-header > span {
        font-size: 8px;
    }

    .card-body {
        padding: 14px;
    }


    /* FORMS */

    .form-grid {
        grid-template-columns: 1fr;

        gap: 12px;
    }

    .form-group.full {
        grid-column: auto;
    }

    input,
    select,
    textarea {
        font-size: 16px;
    }

    input,
    select {
        min-height: 48px;
    }

    textarea {
        min-height: 110px;
    }


    /* SUMMARY */

    .summary-grid {
        grid-template-columns:
            repeat(2,minmax(0,1fr));

        gap: 7px;
    }

    .summary-box {
        padding: 13px 8px;
    }

    .summary-number {
        font-size: 24px;
    }


    /* ACTIONS */

    .action-grid {
        position: sticky;
        bottom: 8px;

        z-index: 150;

        grid-template-columns:
            minmax(0,2fr)
            minmax(110px,1fr);

        padding: 7px;

        margin: 0 0 12px;

        background: rgba(255,255,255,.96);

        border: 1px solid #ddd;
        border-radius: 12px;

        box-shadow:
            0 8px 30px rgba(0,0,0,.16);

        backdrop-filter: blur(8px);
    }

    .action-grid .btn {
        min-height: 48px;

        padding: 10px 8px;

        font-size: 11px;
    }


    /* FILTER HEADER */

    .card-header:has(.filters) {
        display: block;
    }

    .filters {
        margin-top: 10px;

        width: 100%;
    }


    /* PUNCH ITEM */

    .punch-item-top {
        padding: 9px 11px;
    }

    .punch-content {
        padding: 13px;
    }

    .punch-description {
        font-size: 14px;
    }

    .punch-meta {
        display: grid;

        grid-template-columns: 1fr;

        gap: 5px;

        margin-top: 10px;
    }


    /* PHOTOS */

    .photo-grid {
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }

    .photo-grid img {
        height: 120px;
    }

    .photo-preview {
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }

    .preview-wrapper img {
        height: 125px;
    }


    /* ITEM ACTIONS */

    .item-actions {
        gap: 5px;

        padding: 7px;
    }

    .item-actions button {
        min-height: 39px;

        padding: 7px 4px;

        font-size: 9px;
    }


    /* MODAL */

    .modal {
        padding: 0;

        background: white;
    }

    .modal-panel {
        min-height: 100vh;

        margin: 0;

        border: 0;
        border-radius: 0;

        box-shadow: none;
    }

    .modal-header {
        position: sticky;
        top: 0;

        z-index: 20;

        padding: 13px 14px;
    }

    .modal-body {
        padding: 15px 13px 100px;
    }

    .modal-footer {
        position: fixed;

        left: 0;
        right: 0;
        bottom: 0;

        z-index: 30;

        padding:
            9px
            10px
            calc(9px + env(safe-area-inset-bottom));

        background: rgba(255,255,255,.97);

        border-top: 1px solid #ddd;

        box-shadow:
            0 -4px 18px rgba(0,0,0,.08);

        backdrop-filter: blur(8px);
    }

}


/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-width: 390px) {

    .brand-title {
        max-width: 145px;
    }

    .action-grid {
        grid-template-columns:
            minmax(0,1.7fr)
            minmax(95px,1fr);
    }

    .badge {
        padding: 4px 6px;

        font-size: 7px;
    }

}


/* =========================================================
   PRINT / PDF REPORT
   ========================================================= */

.print-report {
    display: none;
}

@media print {

    @page {
        size: Letter;
        margin: .45in;
    }

    html,
    body {
        margin: 0;

        background: white;

        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }

    .topbar,
    .hero,
    .container,
    .footer,
    .modal {
        display: none !important;
    }

    .print-report {
        display: block !important;

        color: #171717;
    }


    /* REPORT HEADER */

    .print-header {
        position: relative;

        padding:
            0
            0
            12px;

        margin-bottom: 14px;

        border-bottom:
            4px solid #c8102e;
    }

    .print-brand {
        font-size: 22px;
        font-weight: 900;

        letter-spacing: -.5px;
    }

    .print-brand span {
        margin-right: 5px;

        color: #c8102e;
    }

    .print-title {
        margin-top: 4px;

        color: #555;

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1.5px;
    }


    /* JOB INFO */

    .print-info {
        display: grid;

        grid-template-columns:
            repeat(2,1fr);

        margin-bottom: 12px;

        border:
            1px solid #cfcfcf;
    }

    .print-info div {
        min-height: 37px;

        padding: 7px 9px;

        border-right:
            1px solid #ddd;

        border-bottom:
            1px solid #ddd;

        font-size: 9px;
    }

    .print-info strong {
        display: block;

        margin-bottom: 2px;

        color: #777;

        font-size: 7px;
        font-weight: 800;

        letter-spacing: .6px;

        text-transform: uppercase;
    }


    /* SUMMARY */

    .print-summary {
        display: flex;
        align-items: center;

        gap: 20px;

        margin-bottom: 13px;

        padding: 8px 10px;

        background: #f0f1f2;

        border-left:
            4px solid #c8102e;

        font-size: 9px;
    }


    /* PUNCH ITEMS */

    .print-item {
        margin-bottom: 10px;

        overflow: hidden;

        border:
            1px solid #bfc1c3;

        page-break-inside: avoid;
        break-inside: avoid;
    }

    .print-item-head {
        padding: 6px 8px;

        display: flex;
        justify-content: space-between;

        gap: 10px;

        background: #eceeef;

        border-bottom:
            1px solid #ccc;

        font-size: 8px;
        font-weight: 800;
    }

    .print-item-body {
        padding: 8px;
    }

    .print-location {
        color: #c8102e;

        font-size: 7px;
        font-weight: 900;

        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .print-description {
        margin-top: 4px;

        font-size: 10px;
        font-weight: 700;

        line-height: 1.35;
    }

    .print-meta {
        margin-top: 6px;

        color: #555;

        font-size: 7.5px;
    }


    /* REPORT PHOTOS */

    .print-photos {
        margin-top: 8px;

        display: grid;

        grid-template-columns:
            repeat(3,1fr);

        gap: 5px;
    }

    .print-photos img {
        width: 100%;
        height: 115px;

        object-fit: cover;

        border:
            1px solid #bbb;
    }


    /* FOOTER */

    .print-footer {
        margin-top: 18px;

        padding-top: 7px;

        border-top:
            1px solid #aaa;

        color: #777;

        font-size: 7px;

        line-height: 1.4;
    }

}


/* =========================================================
   ACCESSIBILITY / REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;

        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
    }

}
