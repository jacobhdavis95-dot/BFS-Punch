:root{--navy:#0b3158;--navy2:#062848;--red:#cf2437;--ink:#142438;--muted:#687789;--line:#dce3e9;--bg:#f4f6f8;--green:#16845b;--orange:#d87820}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-bottom:92px}.topbar{height:72px;background:var(--navy);display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,calc((100vw - 760px)/2));color:#fff;position:sticky;top:0;z-index:10;box-shadow:0 2px 10px #001a3025}.brand{display:flex;align-items:center;color:#fff;text-decoration:none;gap:13px}.brand img{width:145px;max-height:44px;object-fit:contain;filter:brightness(0) invert(1)}.brand-divider{height:30px;width:1px;background:#ffffff55}.brand strong{letter-spacing:2px;font-size:14px}.icon-button{height:36px;width:36px;border:1px solid #ffffff66;border-radius:50%;color:#fff;background:transparent;font-weight:800;font-size:16px}main{max-width:760px;margin:auto}.hero{background:linear-gradient(145deg,var(--navy) 0%,var(--navy2) 100%);color:#fff;padding:30px 24px 42px;display:flex;justify-content:space-between;align-items:center}.eyebrow{font-size:11px;letter-spacing:1.8px;font-weight:800;margin:0 0 7px;color:#66809a}.hero .eyebrow{color:#a8bfd3}.hero h1{font-size:29px;margin:0 0 7px}.hero p:last-child{margin:0;color:#c8d7e4;font-size:14px}.weather{display:grid;grid-template-columns:auto auto;gap:0 7px;align-items:center;border-left:1px solid #ffffff30;padding-left:20px}.weather span{font-size:23px;color:#ffc44d}.weather strong{font-size:24px}.weather small{grid-column:1/3;color:#b9cbda;text-align:right}.project-bar{margin:-19px 18px 0;background:#fff;border-radius:10px;min-height:76px;padding:14px 16px;box-shadow:0 5px 18px #12304a18;display:flex;align-items:center;justify-content:space-between;position:relative}.project-bar>div{display:flex;gap:13px}.pin{color:var(--red);padding-top:14px;font-size:12px}.project-bar small,.project-bar strong,.project-bar span{display:block}.project-bar small{font-size:9px;color:#84909c;letter-spacing:1.2px;font-weight:800}.project-bar strong{font-size:15px;margin:3px 0}.project-bar div span:last-child{font-size:12px;color:var(--muted)}button{font:inherit;cursor:pointer}.project-bar button,.section-heading button{background:none;border:0;color:var(--red);font-size:12px;font-weight:800}.quick-actions{padding:23px 18px 12px}.primary-action{width:100%;height:83px;border:0;border-radius:9px;background:var(--red);color:white;display:flex;align-items:center;text-align:left;padding:0 20px;box-shadow:0 5px 13px #cf243730}.primary-action>span{font-size:36px;font-weight:200;margin-right:16px}.primary-action div{display:flex;flex-direction:column;gap:4px;flex:1}.primary-action strong{font-size:17px}.primary-action small{color:#ffe2e5}.primary-action b{font-size:31px;font-weight:300}.secondary-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.secondary-actions button{height:64px;background:white;border:1px solid var(--line);border-radius:8px;color:var(--navy);font-size:13px;font-weight:700}.secondary-actions span{color:var(--red);font-size:20px;margin-right:9px}.items-section{padding:8px 18px}.section-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.section-heading>div{display:flex;align-items:center;gap:8px}.section-heading h2{font-size:18px}.count{color:#fff;background:var(--navy);font-weight:800;border-radius:20px;min-width:22px;text-align:center;padding:3px 7px;font-size:11px}.filters{display:flex;gap:7px;overflow:auto;padding-bottom:11px}.filters button{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:20px;padding:7px 13px;font-size:12px}.filters button.active{background:var(--navy);color:#fff}.item-list{display:grid;gap:10px}.item-card{background:#fff;border:1px solid var(--line);border-radius:9px;display:grid;grid-template-columns:98px 1fr;min-height:112px;overflow:hidden;box-shadow:0 2px 6px #12273a0a}.item-photo{background:#d9e0e5;position:relative;min-height:112px}.item-photo img{height:100%;width:100%;object-fit:cover}.item-photo .placeholder{height:100%;display:grid;place-items:center;color:#71808c;font-size:25px}.photo-count{position:absolute;bottom:7px;left:7px;background:#071d2ddd;color:#fff;border-radius:3px;padding:3px 6px;font-size:10px}.item-content{padding:12px 13px}.badges{display:flex;gap:5px}.badge{font-size:9px;font-weight:900;letter-spacing:.6px;border-radius:3px;padding:3px 6px;text-transform:uppercase}.urgent{background:#ffe3e2;color:#b5272d}.new{background:#e6f0fa;color:#24628e}.assigned{background:#e0f4eb;color:#147452}.item-content h3{font-size:14px;margin:8px 0 5px}.item-content p{font-size:11px;color:var(--muted);margin:0 0 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#71808c}.avatar{display:inline-grid;place-items:center;width:20px;height:20px;background:#dce4eb;border-radius:50%;font-size:8px;color:var(--navy);font-weight:900;margin-right:5px}.view-all{width:100%;height:50px;background:transparent;border:0;color:var(--navy);font-size:12px;font-weight:800}.view-all span{font-size:20px;margin-left:5px}.empty{text-align:center;background:#fff;padding:30px;border:1px solid var(--line);border-radius:9px}.empty span{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#daf3e8;color:var(--green);font-size:22px}.empty h3{margin-bottom:5px}.empty p{color:var(--muted);font-size:13px}.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:76px;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:center;z-index:20;padding-bottom:env(safe-area-inset-bottom)}.bottom-nav button{width:min(18%,135px);border:0;background:transparent;color:#7c8995;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:10px;font-weight:700}.bottom-nav button span{font-size:19px}.bottom-nav .active{color:var(--red)}.bottom-nav .nav-add{transform:translateY(-19px);color:var(--navy)}.bottom-nav .nav-add span{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--red);color:white;font-size:31px;border:5px solid var(--bg);box-sizing:content-box}.bottom-nav .nav-add b{font-size:10px}dialog{border:0;border-radius:14px;padding:0;width:min(600px,calc(100% - 24px));max-height:92vh;color:var(--ink);box-shadow:0 24px 70px #00182e55}dialog::backdrop{background:#031a2db8}dialog form{padding:24px}.dialog-head{display:flex;justify-content:space-between;align-items:start}.dialog-head h2{margin:0 0 18px;font-size:24px}.close{border:0;background:#edf1f4;color:#53616e;border-radius:50%;height:36px;width:36px;font-size:22px}.photo-drop{border:2px dashed #aebbc6!important;background:#f7f9fa;border-radius:10px;min-height:135px;display:flex!important;align-items:center;justify-content:center;flex-direction:column;color:var(--navy);margin-bottom:14px}.photo-drop input{display:none}.photo-drop .camera{font-size:27px;color:var(--red);margin-bottom:5px}.photo-drop small{color:var(--muted);margin-top:4px;font-weight:400}.photo-preview{display:flex;gap:8px;overflow:auto;margin-bottom:12px}.photo-preview img{width:90px;height:70px;object-fit:cover;border-radius:6px}form label{display:block;font-size:12px;font-weight:800;color:#3a4b5c;margin-top:12px}input,textarea,select{display:block;width:100%;margin-top:6px;border:1px solid #bfc9d1;border-radius:7px;padding:12px;font:inherit;font-size:16px;color:var(--ink);background:white}textarea{resize:vertical}.form-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}.save-button{border:0;background:var(--red);color:#fff;width:100%;padding:15px;border-radius:8px;font-weight:800;margin-top:20px}.small-dialog{padding:28px}.small-dialog .close{float:right}.small-dialog p{line-height:1.6;color:var(--muted)}.toast{position:fixed;left:50%;bottom:95px;transform:translate(-50%,20px);background:#102b43;color:#fff;border-radius:7px;padding:11px 18px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:40}.toast.show{opacity:1;transform:translate(-50%,0)}@media(min-width:761px){body{padding-bottom:30px}.topbar{padding-left:calc((100vw - 760px)/2 + 22px);padding-right:calc((100vw - 760px)/2 + 22px)}main{box-shadow:0 0 35px #0b315810;background:white}.bottom-nav{position:sticky;width:760px;margin:auto;border:1px solid var(--line);border-radius:12px 12px 0 0}.items-section{padding-bottom:25px}}@media(max-width:440px){.weather{display:none}.hero h1{font-size:25px}.form-grid{grid-template-columns:1fr}.brand img{width:128px}.item-card{grid-template-columns:91px 1fr}}
