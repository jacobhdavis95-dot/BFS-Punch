:root{--navy:#0b2341;--navy-2:#153e68;--red:#d2263d;--red-dark:#ad1930;--ink:#172638;--muted:#68788a;--line:#dce3e9;--bg:#f1f4f6;--surface:#fff;--green:#19835f;--amber:#e58b25;--shadow-sm:0 2px 8px rgba(11,35,65,.06);--shadow:0 16px 40px rgba(11,35,65,.12);--radius:16px}
*{box-sizing:border-box}html{color-scheme:light;scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-bottom:104px;-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid rgba(47,126,193,.3);outline-offset:2px}
.topbar{height:76px;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100vw - 1180px)/2));position:sticky;top:0;z-index:20;backdrop-filter:blur(14px)}.brand{display:inline-flex}.brand img{display:block;width:174px;height:48px;object-fit:contain}.profile{border:1px solid transparent;background:transparent;display:flex;align-items:center;gap:11px;color:var(--ink);padding:7px 10px;border-radius:12px}.profile:hover{background:#f3f6f8;border-color:var(--line)}.profile>span:first-child{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;font-size:11px;font-weight:900}.profile-copy{display:flex;flex-direction:column;text-align:left}.profile-copy strong{font-size:12px}.profile-copy small{font-size:10px;color:var(--muted);margin-top:2px}.profile b{color:#8290a0}
main{max-width:1180px;margin:auto}.hero{min-height:212px;margin-top:28px;border-radius:22px;background:linear-gradient(120deg,#091e38 0%,#103b66 64%,#18537e 100%);color:#fff;padding:42px 46px 62px;display:flex;justify-content:space-between;align-items:center;position:relative;overflow:hidden;box-shadow:0 20px 45px rgba(11,35,65,.15)}.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;pointer-events:none}.hero:before{width:330px;height:330px;border:65px solid rgba(255,255,255,.035);right:-100px;top:-155px}.hero:after{width:170px;height:170px;background:rgba(255,255,255,.025);right:185px;bottom:-120px}.hero-copy,.hero-date{position:relative;z-index:1}.eyebrow,.section-kicker{font-size:10px;letter-spacing:1.8px;font-weight:900;margin:0 0 8px;color:#75869a}.hero .eyebrow{color:#8fb6d5}.hero h1{font-size:clamp(30px,4vw,42px);line-height:1.08;letter-spacing:-1.3px;margin:0 0 12px}.hero-copy>p:last-child{margin:0;color:#cedcea;font-size:14px}.hero-date{border-left:1px solid rgba(255,255,255,.24);padding-left:30px;display:flex;flex-direction:column;gap:6px;text-align:right}.hero-date span{color:#9dbbd2;font-size:9px;text-transform:uppercase;letter-spacing:1.5px;font-weight:900}.hero-date strong{font-size:14px}
.project-bar{margin:-35px 32px 0;background:#fff;border:1px solid rgba(220,227,233,.9);border-radius:15px;min-height:98px;padding:18px 22px;box-shadow:var(--shadow);display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.project-details{display:flex;align-items:center;gap:14px}.project-mark{display:grid;place-items:center;width:48px;height:48px;border-radius:12px;background:linear-gradient(145deg,#e8eef4,#f5f7f9);border:1px solid #dce5ec;color:var(--navy);font-weight:900;font-size:11px}.project-details small,.project-details strong,.project-details div>span{display:block}.project-details small{font-size:9px;color:#8491a0;letter-spacing:1.3px;font-weight:900}.project-details strong{font-size:15px;margin:4px 0}.project-details div>span{font-size:11px;color:var(--muted)}.project-details i{font-style:normal;color:#b1bbc4;margin:0 4px}.project-bar button,.section-heading button{background:#f6f8fa;border:1px solid var(--line);border-radius:9px;color:var(--navy);font-size:11px;font-weight:850;padding:10px 14px}.project-bar button:hover,.section-heading button:hover{background:#eaf0f5}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:24px 32px 6px}.summary-grid>div{min-height:82px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px 18px;display:flex;align-items:center;gap:13px;box-shadow:var(--shadow-sm)}.summary-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:11px;font-weight:900}.open-icon{background:#e8eff6;color:var(--navy)}.urgent-icon{background:#fde8eb;color:var(--red)}.progress-icon{background:#e3f3ec;color:var(--green)}.summary-grid p{margin:0}.summary-grid strong,.summary-grid small{display:block}.summary-grid strong{font-size:21px;line-height:1}.summary-grid small{font-size:10px;color:var(--muted);margin-top:6px}
.quick-actions{padding:31px 32px 25px}.section-label{display:flex;justify-content:space-between;align-items:end;margin-bottom:14px}.section-label h2,.section-heading h2{font-size:22px;letter-spacing:-.45px;margin:0}.section-label small{color:var(--muted);font-size:11px}.section-kicker{margin-bottom:5px}.action-grid{display:grid;grid-template-columns:1.7fr 1fr 1fr;gap:12px}.action-grid button{min-height:86px;background:#fff;border:1px solid var(--line);border-radius:14px;color:var(--navy);display:flex;align-items:center;text-align:left;padding:16px 18px;gap:12px;box-shadow:var(--shadow-sm);transition:transform .18s,box-shadow .18s,border-color .18s}.action-grid button:hover{transform:translateY(-2px);border-color:#c4d0da;box-shadow:0 10px 24px rgba(11,35,65,.1)}.action-grid .primary-action{border:0;background:linear-gradient(135deg,var(--red),var(--red-dark));color:#fff;box-shadow:0 10px 22px rgba(190,27,49,.22)}.action-icon{display:grid;place-items:center;flex:0 0 auto;width:42px;height:42px;border-radius:11px;background:#edf2f6;color:var(--red);font-size:20px}.primary-action .action-icon{background:rgba(255,255,255,.15);color:#fff;font-size:28px}.action-grid button>span:nth-child(2){display:flex;flex-direction:column;gap:5px;flex:1}.action-grid strong{font-size:13px}.action-grid small{font-size:10px;color:var(--muted)}.primary-action small{color:#ffdde2}.primary-action b{font-size:25px;font-weight:300}
.items-section{padding:9px 32px 30px}.section-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.section-heading>div{display:flex;align-items:center;gap:10px}.count{color:#fff;background:var(--navy);font-weight:900;border-radius:20px;min-width:24px;text-align:center;padding:4px 8px;font-size:10px}.filters{display:flex;gap:8px;overflow:auto;padding-bottom:13px}.filters button{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:20px;padding:8px 15px;font-size:11px}.filters button.active{background:var(--navy);border-color:var(--navy);color:#fff}.item-list{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.item-card{background:#fff;border:1px solid var(--line);border-radius:14px;display:grid;grid-template-columns:96px 1fr;min-height:134px;overflow:hidden;box-shadow:var(--shadow-sm);transition:transform .18s,box-shadow .18s}.item-card:hover{transform:translateY(-3px);box-shadow:0 13px 28px rgba(11,35,65,.11)}.item-photo{background:linear-gradient(145deg,#e6ebef,#f2f4f6);position:relative}.item-photo img{height:100%;width:100%;object-fit:cover}.item-photo .placeholder{height:100%;display:grid;place-items:center;color:#91a0ad;font-size:25px}.photo-count{position:absolute;bottom:8px;left:8px;background:rgba(7,29,45,.88);color:#fff;border-radius:5px;padding:4px 7px;font-size:9px}.item-content{padding:14px 13px;min-width:0}.badges{display:flex;gap:5px}.badge{font-size:8px;font-weight:900;letter-spacing:.65px;border-radius:4px;padding:4px 6px;text-transform:uppercase}.urgent{background:#fce5e8;color:#ae2637}.new{background:#e4eff8;color:#255f89}.assigned{background:#e1f2ea;color:#17684d}.item-content h3{font-size:13px;margin:9px 0 6px;line-height:1.25}.item-content p{font-size:10px;color:var(--muted);margin:0 0 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:space-between;align-items:center;gap:5px;font-size:9px;color:#71808c}.meta>span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.avatar{display:inline-grid;place-items:center;width:22px;height:22px;background:#e7edf2;border-radius:50%;font-size:8px;color:var(--navy);font-style:normal;font-weight:900;margin-right:5px}.view-all{width:100%;height:54px;background:transparent;border:0;color:var(--navy);font-size:11px;font-weight:900}.view-all span{font-size:18px;margin-left:4px}.empty{text-align:center;background:#fff;padding:34px;border:1px solid var(--line);border-radius:14px}.empty span{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#daf3e8;color:var(--green);font-size:22px}.empty h3{margin-bottom:5px}.empty p{color:var(--muted);font-size:13px}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:76px;background:rgba(255,255,255,.97);border-top:1px solid var(--line);display:flex;justify-content:center;z-index:20;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -8px 24px rgba(11,35,65,.06);backdrop-filter:blur(12px)}.bottom-nav button{width:min(18%,135px);border:0;background:transparent;color:#778794;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:9px;font-weight:800}.bottom-nav button span{font-size:19px}.bottom-nav .active{color:var(--red)}.bottom-nav .nav-add{transform:translateY(-17px);color:var(--navy)}.bottom-nav .nav-add span{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:linear-gradient(145deg,#e52c45,#bd1b32);color:#fff;font-size:28px;border:5px solid var(--bg);box-sizing:content-box;box-shadow:0 7px 15px rgba(190,27,49,.25)}.bottom-nav .nav-add b{font-size:9px}
dialog{border:0;border-radius:18px;padding:0;width:min(600px,calc(100% - 24px));max-height:92vh;color:var(--ink);box-shadow:0 24px 70px rgba(0,24,46,.35)}dialog::backdrop{background:rgba(3,19,35,.72);backdrop-filter:blur(3px)}dialog form{padding:26px}.dialog-head{display:flex;justify-content:space-between;align-items:start}.dialog-head h2{margin:0 0 18px;font-size:24px}.close{border:0;background:#edf1f4;color:#53616e;border-radius:50%;height:36px;width:36px;font-size:22px}.photo-drop{border:2px dashed #aebbc6!important;background:#f7f9fa;border-radius:12px;min-height:138px;display:flex!important;align-items:center;justify-content:center;flex-direction:column;color:var(--navy);margin-bottom:14px}.photo-drop input{display:none}.photo-drop .camera{font-size:27px;color:var(--red);margin-bottom:5px}.photo-drop small{color:var(--muted);margin-top:4px;font-weight:400}.photo-preview{display:flex;gap:8px;overflow:auto;margin-bottom:12px}.photo-preview img{width:90px;height:70px;object-fit:cover;border-radius:7px}form label{display:block;font-size:12px;font-weight:800;color:#3a4b5c;margin-top:12px}input,textarea,select{display:block;width:100%;margin-top:6px;border:1px solid #bfc9d1;border-radius:9px;padding:12px;font-size:16px;color:var(--ink);background:#fff}textarea{resize:vertical}.form-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}.save-button{border:0;background:var(--red);color:#fff;width:100%;padding:15px;border-radius:9px;font-weight:800;margin-top:20px}.small-dialog{padding:28px}.small-dialog .close{float:right}.small-dialog p{line-height:1.6;color:var(--muted)}.toast{position:fixed;left:50%;bottom:94px;transform:translate(-50%,20px);background:#102b43;color:#fff;border-radius:9px;padding:12px 18px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:40}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(min-width:900px){body{padding-bottom:30px}.bottom-nav{position:sticky;width:620px;margin:18px auto 0;border:1px solid var(--line);border-radius:16px}.items-section{padding-bottom:8px}}
@media(max-width:899px){.topbar{padding:0 20px}.hero{margin:0;border-radius:0}.item-list{grid-template-columns:1fr}.item-card{grid-template-columns:108px 1fr}}
@media(max-width:600px){.topbar{height:66px;padding:0 16px}.brand img{width:142px;height:44px}.profile-copy,.profile b{display:none}.profile>span:first-child{width:34px;height:34px}.hero{min-height:174px;padding:30px 20px 52px}.hero-date{display:none}.hero h1{font-size:29px}.hero-copy>p:last-child{font-size:12px}.project-bar{margin:-30px 14px 0;padding:14px;min-height:88px}.project-mark{width:44px;height:44px}.project-bar button{padding:8px 10px}.summary-grid{padding:17px 14px 4px;gap:8px}.summary-grid>div{padding:11px 9px;gap:8px;min-height:69px}.summary-icon{width:32px;height:32px}.summary-grid strong{font-size:17px}.summary-grid small{font-size:9px}.quick-actions,.items-section{padding-left:14px;padding-right:14px}.quick-actions{padding-top:25px}.action-grid{grid-template-columns:1fr 1fr}.action-grid .primary-action{grid-column:1/-1}.action-grid button{min-height:72px;padding:12px}.action-grid .primary-action{min-height:80px}.action-icon{width:36px;height:36px}.section-label small{display:none}.item-card{grid-template-columns:92px 1fr;min-height:120px}.form-grid{grid-template-columns:1fr}}
@media(max-width:360px){.summary-icon{display:none}.summary-grid>div{justify-content:center}.project-details{gap:9px}.project-details strong{font-size:13px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
:root{--navy:#112a46;--navy2:#1c466d;--red:#d4263e;--ink:#172638;--muted:#6e7c8b;--line:#dce3e9;--bg:#f3f5f7;--white:#fff;--green:#21845f;--shadow:0 10px 30px rgba(17,42,70,.08);--radius:16px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid rgba(38,111,167,.25);outline-offset:2px}
.topbar{height:74px;background:rgba(255,255,255,.97);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100vw - 1120px)/2));position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.brand img{display:block;width:168px;height:48px;object-fit:contain}.top-actions{display:flex;align-items:center;gap:20px}.save-state{font-size:11px;font-weight:750;color:var(--muted);display:flex;align-items:center;gap:7px}.save-state i{width:7px;height:7px;border-radius:50%;background:var(--green)}.avatar{width:38px;height:38px;border:0;border-radius:50%;background:var(--navy);color:white;font-size:11px;font-weight:900}
main{max-width:1120px;margin:auto;padding:54px 24px 80px}.page-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.eyebrow{margin:0 0 7px;color:#7b8997;font-weight:900;font-size:9px;letter-spacing:1.8px}.page-heading h1{margin:0;font-size:clamp(32px,5vw,46px);letter-spacing:-1.6px;line-height:1.1}.page-heading>div>p:last-child{color:var(--muted);font-size:14px;margin:12px 0 0}.heading-date{border-left:1px solid var(--line);padding:5px 0 5px 25px;display:flex;flex-direction:column;gap:6px}.heading-date span{font-size:9px;font-weight:900;letter-spacing:1.4px;color:#8592a0}.heading-date strong{font-size:13px}
#reportForm{display:grid;gap:18px}.form-section{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:30px 34px}.section-header{display:flex;align-items:flex-start;gap:15px;padding-bottom:25px;border-bottom:1px solid #e8edf1;margin-bottom:26px}.section-header .step{display:grid;place-items:center;flex:0 0 auto;width:40px;height:40px;background:#e9eff5;border-radius:10px;color:var(--navy);font-size:11px;font-weight:900}.section-header h2{font-size:21px;margin:0;letter-spacing:-.4px}.section-header div>p:last-child{font-size:11px;color:var(--muted);margin:6px 0 0}.items-header .item-total{margin-left:auto;background:#eef2f5;border-radius:20px;padding:7px 12px;color:var(--navy);font-size:10px;font-weight:900}
.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:19px 16px}.fields .wide{grid-column:span 2}label{font-size:11px;color:#405162;font-weight:800}input,textarea,select{display:block;width:100%;margin-top:7px;padding:12px 13px;border:1px solid #c8d1d9;border-radius:8px;background:#fff;color:var(--ink);font-size:14px;transition:border-color .15s,box-shadow .15s}input::placeholder,textarea::placeholder{color:#a0aab3}input:focus,textarea:focus,select:focus{border-color:#4d85ae;box-shadow:0 0 0 3px rgba(77,133,174,.09);outline:0}textarea{resize:vertical;line-height:1.5}
.punch-items{display:grid;gap:16px}.punch-card{border:1px solid #d6dfe6;border-radius:13px;background:#fafbfc;padding:20px}.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:17px}.card-top>div{display:flex;align-items:center;gap:10px}.item-number{font-size:9px;letter-spacing:1.2px;color:var(--red);font-weight:900}.card-top h3{font-size:13px;margin:0;padding-left:10px;border-left:1px solid var(--line)}.remove-item{border:0;background:#edf1f4;color:#61707d;width:29px;height:29px;border-radius:50%;font-size:18px}.item-layout{display:grid;grid-template-columns:190px 1fr;gap:20px}.photo-upload{margin:0;border:1.5px dashed #aab8c3;border-radius:10px;background:#f2f5f7;min-height:212px;display:grid;place-items:center;text-align:center;overflow:hidden;position:relative}.photo-upload input{display:none}.photo-empty{display:flex;align-items:center;flex-direction:column}.photo-empty b{display:grid;place-items:center;width:38px;height:38px;background:var(--navy);color:#fff;border-radius:50%;font-size:22px;font-weight:400;margin-bottom:10px}.photo-empty strong{font-size:12px;color:var(--navy)}.photo-empty small{font-size:9px;color:var(--muted);font-weight:500;margin-top:4px}.photo-previews:not(:empty){position:absolute;inset:0;display:grid;grid-template-columns:repeat(2,1fr);gap:3px;background:#fff}.photo-previews img{width:100%;height:100%;min-height:70px;object-fit:cover}.item-fields>label{display:block;margin-top:14px}.fields.compact{grid-template-columns:1fr 1fr;gap:12px}.fields.compact.three{grid-template-columns:1.2fr .8fr 1fr;margin-top:13px}.item-fields .fields label{margin:0}
.add-item{margin-top:16px;width:100%;height:68px;border:1.5px dashed #9eafbc;border-radius:11px;background:#f7f9fa;color:var(--navy);display:flex;align-items:center;justify-content:center;gap:10px}.add-item span{font-size:23px;color:var(--red)}.add-item strong{font-size:12px}.add-item small{font-size:10px;color:var(--muted);font-weight:500;border-left:1px solid var(--line);padding-left:10px}.add-item:hover{background:#eef3f6;border-color:#6f8799}
.deadline-card{display:grid;grid-template-columns:56px 220px 1fr;align-items:end;gap:18px}.calendar-icon{display:grid;place-items:center;width:52px;height:48px;border-radius:10px;background:#fce7ea;color:var(--red);font-size:22px}.form-footer{background:var(--navy);color:white;border-radius:var(--radius);padding:20px 24px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow)}.form-footer>div{display:flex;flex-direction:column;gap:4px;margin-right:auto}.form-footer>div strong{font-size:13px}.form-footer>div span{font-size:10px;color:#abc0d2}.form-footer button{border-radius:8px;padding:12px 17px;font-size:11px;font-weight:900}.secondary{background:transparent;border:1px solid #667b90;color:white}.primary{border:0;background:var(--red);color:white;min-width:190px}.primary span{font-size:17px;margin-left:7px}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:#102b43;color:#fff;border-radius:9px;padding:13px 19px;font-size:12px;opacity:0;pointer-events:none;transition:.2s;z-index:20}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:800px){main{padding:35px 16px 60px}.heading-date{display:none}.fields,.project-fields{grid-template-columns:1fr 1fr}.fields .wide{grid-column:span 1}.item-layout{grid-template-columns:1fr}.photo-upload{min-height:150px}.deadline-card{grid-template-columns:52px 1fr}.deadline-card label:last-child{grid-column:1/-1}.form-footer{flex-wrap:wrap}.form-footer>div{width:100%}}
@media(max-width:520px){.topbar{height:66px;padding:0 15px}.brand img{width:142px}.save-state{display:none}.page-heading h1{font-size:32px}.form-section{padding:22px 16px}.section-header{gap:11px}.section-header .step{width:35px;height:35px}.section-header h2{font-size:18px}.fields,.project-fields,.fields.compact,.fields.compact.three{grid-template-columns:1fr}.items-header .item-total{display:none}.punch-card{padding:16px 12px}.add-item small{display:none}.deadline-card{grid-template-columns:1fr}.calendar-icon{display:none}.deadline-card label:last-child{grid-column:auto}.form-footer .secondary,.form-footer .primary{flex:1}.form-footer .primary{min-width:170px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
