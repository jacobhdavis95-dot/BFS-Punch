:root{--navy:#071f4f;--navy-2:#12396c;--red:#c82034;--ink:#132238;--muted:#68778a;--line:#dfe5eb;--bg:#f3f5f7;--surface:#fff;--green:#18805d;--orange:#f59a23;--shadow:0 10px 30px rgba(13,35,66,.09)}
*{box-sizing:border-box}html{color-scheme:light;scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-bottom:94px;-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid rgba(30,100,170,.25);outline-offset:2px}
.topbar{height:74px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,calc((100vw - 1120px)/2));position:relative;z-index:2}.brand{display:inline-flex}.brand img{display:block;width:174px;height:50px;object-fit:contain}.profile{border:0;background:transparent;display:flex;align-items:center;gap:10px;color:var(--ink);padding:6px}.profile>span:first-child{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#e8edf3;color:var(--navy);font-size:12px;font-weight:900}.profile-copy{display:flex;flex-direction:column;text-align:left}.profile-copy strong{font-size:12px}.profile-copy small{font-size:10px;color:var(--muted)}.profile b{color:#8290a0}
main{max-width:1120px;margin:auto}.hero{min-height:180px;margin-top:24px;border-radius:16px;background:linear-gradient(115deg,#082657 0%,#103e73 75%,#155083 100%);color:#fff;padding:34px 40px 52px;display:flex;justify-content:space-between;align-items:center;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:250px;height:250px;border:54px solid rgba(255,255,255,.04);border-radius:50%;right:-70px;top:-86px}.eyebrow,.section-kicker{font-size:10px;letter-spacing:1.7px;font-weight:900;margin:0 0 7px;color:#75869a}.hero .eyebrow{color:#9eb9d2}.hero h1{font-size:clamp(28px,4vw,38px);letter-spacing:-.9px;margin:0 0 8px}.hero p:last-child{margin:0;color:#d3dfeb;font-size:14px}.hero-date{border-left:1px solid rgba(255,255,255,.25);padding-left:28px;display:flex;flex-direction:column;gap:5px;text-align:right;z-index:1}.hero-date span{color:#9eb9d2;font-size:10px;text-transform:uppercase;letter-spacing:1.3px;font-weight:800}.hero-date strong{font-size:14px}
.project-bar{margin:-30px 28px 0;background:#fff;border:1px solid var(--line);border-radius:13px;min-height:92px;padding:16px 20px;box-shadow:var(--shadow);display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.project-details{display:flex;align-items:center;gap:14px}.project-mark{display:grid;place-items:center;width:46px;height:46px;border-radius:10px;background:#e8eef5;color:var(--navy);font-weight:900;font-size:12px}.project-details small,.project-details strong,.project-details div>span{display:block}.project-details small{font-size:9px;color:#7e8c9a;letter-spacing:1.2px;font-weight:900}.project-details strong{font-size:15px;margin:4px 0}.project-details div>span{font-size:12px;color:var(--muted)}.project-details i{font-style:normal;color:#b1bbc4;margin:0 4px}.project-bar button,.section-heading button{background:#f7f9fb;border:1px solid var(--line);border-radius:8px;color:var(--navy);font-size:11px;font-weight:800;padding:9px 12px}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:22px 28px 4px}.summary-grid>div{min-height:74px;background:#fff;border:1px solid var(--line);border-radius:11px;padding:13px 16px;display:flex;align-items:center;gap:12px}.summary-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:9px;font-weight:900}.open-icon{background:#e9eff7;color:var(--navy)}.urgent-icon{background:#fde9e9;color:var(--red)}.progress-icon{background:#e4f3ec;color:var(--green)}.summary-grid p{margin:0}.summary-grid strong,.summary-grid small{display:block}.summary-grid strong{font-size:19px;line-height:1}.summary-grid small{font-size:10px;color:var(--muted);margin-top:5px}
.quick-actions{padding:27px 28px 22px}.section-label{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.section-label h2{font-size:20px;margin:0}.section-label small{color:var(--muted);font-size:11px}.section-kicker{margin-bottom:4px}.action-grid{display:grid;grid-template-columns:1.8fr 1fr 1fr;gap:10px}.action-grid button{min-height:78px;background:#fff;border:1px solid var(--line);border-radius:11px;color:var(--navy);display:flex;align-items:center;text-align:left;padding:14px 16px;gap:11px}.action-grid .primary-action{border:0;background:linear-gradient(135deg,var(--red),#ad1a2d);color:#fff;box-shadow:0 7px 18px rgba(181,28,47,.2)}.action-icon{display:grid;place-items:center;flex:0 0 auto;width:38px;height:38px;border-radius:9px;background:#eef2f6;color:var(--red);font-size:19px}.primary-action .action-icon{background:rgba(255,255,255,.16);color:#fff;font-size:27px}.action-grid button>span:nth-child(2){display:flex;flex-direction:column;gap:4px;flex:1}.action-grid strong{font-size:13px}.action-grid small{font-size:10px;color:var(--muted)}.primary-action small{color:#ffdce1}.primary-action b{font-size:25px;font-weight:300}
.items-section{padding:7px 28px 25px}.section-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.section-heading>div{display:flex;align-items:center;gap:9px}.section-heading h2{font-size:21px;margin:0;letter-spacing:-.3px}.count{color:#fff;background:var(--navy);font-weight:900;border-radius:20px;min-width:23px;text-align:center;padding:4px 7px;font-size:10px}.filters{display:flex;gap:7px;overflow:auto;padding-bottom:11px}.filters button{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:20px;padding:7px 14px;font-size:11px}.filters button.active{background:var(--navy);border-color:var(--navy);color:#fff}.item-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.item-card{background:#fff;border:1px solid var(--line);border-radius:11px;display:grid;grid-template-columns:90px 1fr;min-height:126px;overflow:hidden;box-shadow:0 3px 9px rgba(18,39,58,.03);transition:.15s}.item-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}.item-photo{background:#e7ebef;position:relative}.item-photo img{height:100%;width:100%;object-fit:cover}.item-photo .placeholder{height:100%;display:grid;place-items:center;color:#8795a1;font-size:24px}.photo-count{position:absolute;bottom:7px;left:7px;background:rgba(7,29,45,.88);color:#fff;border-radius:4px;padding:3px 6px;font-size:9px}.item-content{padding:13px 12px;min-width:0}.badges{display:flex;gap:5px}.badge{font-size:8px;font-weight:900;letter-spacing:.6px;border-radius:3px;padding:3px 6px;text-transform:uppercase}.urgent{background:#fce5e6;color:#aa2933}.new{background:#e7f0f8;color:#285f88}.assigned{background:#e2f2eb;color:#17684d}.item-content h3{font-size:13px;margin:8px 0 5px}.item-content p{font-size:10px;color:var(--muted);margin:0 0 9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:space-between;align-items:center;gap:5px;font-size:9px;color:#71808c}.meta>span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.avatar{display:inline-grid;place-items:center;width:21px;height:21px;background:#e5ebf0;border-radius:50%;font-size:8px;color:var(--navy);font-style:normal;font-weight:900;margin-right:5px}.view-all{width:100%;height:50px;background:transparent;border:0;color:var(--navy);font-size:11px;font-weight:900}.view-all span{font-size:18px;margin-left:4px}.empty{text-align:center;background:#fff;padding:30px;border:1px solid var(--line);border-radius:10px}.empty span{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#daf3e8;color:var(--green);font-size:22px}.empty h3{margin-bottom:5px}.empty p{color:var(--muted);font-size:13px}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:72px;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:center;z-index:20;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -5px 20px rgba(13,35,66,.05)}.bottom-nav button{width:min(18%,135px);border:0;background:transparent;color:#778794;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:9px;font-weight:800}.bottom-nav button span{font-size:18px}.bottom-nav .active{color:var(--red)}.bottom-nav .nav-add{transform:translateY(-16px);color:var(--navy)}.bottom-nav .nav-add span{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:var(--red);color:#fff;font-size:28px;border:5px solid var(--bg);box-sizing:content-box}.bottom-nav .nav-add b{font-size:9px}
dialog{border:0;border-radius:14px;padding:0;width:min(600px,calc(100% - 24px));max-height:92vh;color:var(--ink);box-shadow:0 24px 70px rgba(0,24,46,.35)}dialog::backdrop{background:rgba(3,26,45,.72)}dialog form{padding:24px}.dialog-head{display:flex;justify-content:space-between;align-items:start}.dialog-head h2{margin:0 0 18px;font-size:24px}.close{border:0;background:#edf1f4;color:#53616e;border-radius:50%;height:36px;width:36px;font-size:22px}.photo-drop{border:2px dashed #aebbc6!important;background:#f7f9fa;border-radius:10px;min-height:135px;display:flex!important;align-items:center;justify-content:center;flex-direction:column;color:var(--navy);margin-bottom:14px}.photo-drop input{display:none}.photo-drop .camera{font-size:27px;color:var(--red);margin-bottom:5px}.photo-drop small{color:var(--muted);margin-top:4px;font-weight:400}.photo-preview{display:flex;gap:8px;overflow:auto;margin-bottom:12px}.photo-preview img{width:90px;height:70px;object-fit:cover;border-radius:6px}form label{display:block;font-size:12px;font-weight:800;color:#3a4b5c;margin-top:12px}input,textarea,select{display:block;width:100%;margin-top:6px;border:1px solid #bfc9d1;border-radius:7px;padding:12px;font-size:16px;color:var(--ink);background:#fff}textarea{resize:vertical}.form-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}.save-button{border:0;background:var(--red);color:#fff;width:100%;padding:15px;border-radius:8px;font-weight:800;margin-top:20px}.small-dialog{padding:28px}.small-dialog .close{float:right}.small-dialog p{line-height:1.6;color:var(--muted)}.toast{position:fixed;left:50%;bottom:90px;transform:translate(-50%,20px);background:#102b43;color:#fff;border-radius:7px;padding:11px 18px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:40}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(min-width:900px){body{padding-bottom:30px}.bottom-nav{position:sticky;width:620px;margin:15px auto 0;border:1px solid var(--line);border-radius:14px}.items-section{padding-bottom:8px}}
@media(max-width:899px){.topbar{padding:0 20px}.hero{margin:0;border-radius:0}.item-list{grid-template-columns:1fr}.item-card{grid-template-columns:104px 1fr}}
@media(max-width:600px){.topbar{height:66px;padding:0 16px}.brand img{width:142px;height:44px}.profile-copy,.profile b{display:none}.profile>span:first-child{width:34px;height:34px}.hero{min-height:164px;padding:28px 20px 48px}.hero-date{display:none}.hero h1{font-size:27px}.project-bar{margin:-26px 14px 0;padding:14px;min-height:84px}.project-mark{width:42px;height:42px}.project-bar button{padding:8px}.summary-grid{padding:16px 14px 4px;gap:7px}.summary-grid>div{padding:10px 8px;gap:7px;min-height:65px}.summary-icon{width:30px;height:30px}.summary-grid strong{font-size:16px}.summary-grid small{font-size:9px}.quick-actions,.items-section{padding-left:14px;padding-right:14px}.quick-actions{padding-top:23px}.action-grid{grid-template-columns:1fr 1fr}.action-grid .primary-action{grid-column:1/-1}.action-grid button{min-height:68px;padding:12px}.action-grid .primary-action{min-height:76px}.action-icon{width:34px;height:34px}.section-label small{display:none}.item-card{grid-template-columns:88px 1fr;min-height:116px}.form-grid{grid-template-columns:1fr}}
@media(max-width:360px){.summary-icon{display:none}.summary-grid>div{justify-content:center}.project-details{gap:9px}.project-details strong{font-size:13px}}
